  m_text: "\u0417\u043E\u043D\u0430 \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0438\u0440\u0443\u0435\u0442
    \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E
    \u043F\u043E\u043B\u0438\u0442\u0438\u043A\u0443\L\u0432\_\u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0438
    \u043C\u043E\u043B\u043E\u0434\u0451\u0436\u0438 \u0438\_\u043F\u044F\u0442\u044C
    \u0432\u0430\u0436\u043D\u0435\u0439\u0448\u0438\u0445 \u0438\u043D\u0438\u0446\u0438\u0430\u0442\u0438\u0432
    \u041F\u0440\u0435\u0437\u0438\u0434\u0435\u043D\u0442\u0430, \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
    \u043F\u0435\u0440\u0441\u043F\u0435\u043A\u0442\u0438\u0432\u044B \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F
    \u043C\u043E\u043B\u043E\u0434\u043E\u0433\u043E \u043F\u043E\u043A\u043E\u043B\u0435\u043D\u0438\u044F
    \u0432\_\u041D\u043E\u0432\u043E\u043C \u0423\u0437\u0431\u0435\u043A\u0438\u0441\u0442\u0430\u043D\u0435
    \L\u0418\u043D\u0442\u0435\u0440\u0430\u043A\u0442\u0438\u0432\u043D\u0430\u044F
    \u0444\u043E\u0442\u043E\u0437\u043E\u043D\u0430 \xAB\u041C\u0435\u0447\u0442\u044B
    \u043E\_\u0431\u0443\u0434\u0443\u0449\u0435\u043C\xBB \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
    \u043F\u043E\u0441\u0435\u0442\u0438\u0442\u0435\u043B\u044F\u043C \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044C
    \u0441\u0435\u0431\u044F \u0447\u0430\u0441\u0442\u044C\u044E \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0439

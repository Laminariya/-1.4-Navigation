  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Yangi O\u2018zbekiston \u2013 Yangi Renassans poydevori zaliga xush kelibsiz!\nBu
    zalda Yangi O'zbekiston orzusi va uni amalga oshirish - bu shunchaki istak yoki
    subyektiv intilish emas, balki chuqur tarixiy shartlarga asoslangan obyektiv
    zarurat ekani, mamlakatimizning hozirgi siyosiy-huquqiy, ijtimoiy-iqtisodiy,
    tashqi siyosat va ma'naviy-ma'rifiy sohalardagi islohotlari bu orzuga mos tarzda
    rivojlanayotgani ko\u2018rsatilgan."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c049d47516a189445be42dc2f4d1d9ce, type: 2}

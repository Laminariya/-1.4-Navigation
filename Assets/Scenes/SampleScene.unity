--- !u!114 &1623888757
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1623888755}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bd8ca4afa928bfe42bfeccd42b5cff45, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Timeout: 60
  Gradient: {fileID: 75430943}
  NameText: {fileID: 1071028474}
  DescriptionText: {fileID: 2051303872}
  HandText: {fileID: 1362338361}
  Hand: {fileID: 917131102}
  Names:
  - "Uchinchi Renessans zaliga\_xush kelibsiz!"
  - "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
    \L\u0432 \u0417\u0430\u043B \u0422\u0440\u0435\u0442\u044C\u0435\u0433\u043E
    \L\u0420\u0435\u043D\u0435\u0441\u0441\u0430\u043D\u0441\u0430!"
  Descriptions:
  - "Bu zalda Yangi O'zbekiston orzusi va uni amalga oshirish - bu shunchaki istak
    yoki subyektiv intilish emas, balki chuqur tarixiy shartlarga asoslangan obyektiv
    zarurat ekani, mamlakatimizning hozirgi siyosiy-huquqiy, ijtimoiy-iqtisodiy,
    tashqi siyosat va ma'naviy-ma'rifiy sohalardagi islohotlari bu orzuga mos tarzda
    rivojlanayotgani ko\u2018rsatilgan."
  - "\u0417\u0434\u0435\u0441\u044C \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430
    \u043A\u043E\u043D\u0446\u0435\u043F\u0446\u0438\u044F \xAB\u041D\u043E\u0432\u044B\u0439\L\u0423\u0437\u0431\u0435\u043A\u0438\u0441\u0442\u0430\u043D\xBB
    \u2014 \u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0438\u044F \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F,
    \L\u043E\u0441\u043D\u043E\u0432\u0430\u043D\u043D\u0430\u044F \u043D\u0430 \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u044F\u0445
    \u0441\u0432\u043E\u0431\u043E\u0434\u044B, \L\u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E\u0441\u0442\u0438
    \u0438 \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u043E\u0433\u043E\L\u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F.
    \u042D\u0442\u0430 \u0437\u043E\u043D\u0430 \u0440\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442\L\u0438\u0434\u0435\u0439\u043D\u044B\u0439
    \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0445\L\u0440\u0435\u0444\u043E\u0440\u043C
    \u0438 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043F\u0443\u0442\u044C
    \u043A \u043D\u043E\u0432\u043E\u043C\u0443\L\u043E\u0431\u0440\u0430\u0437\u0443
    \u043C\u044B\u0448\u043B\u0435\u043D\u0438\u044F \u0438 \u0436\u0438\u0437\u043D\u0438."
  Hands:
  - "Yangi O\u2018zbekiston \u2013 Yangi Renassans poydevori . Kichik harflarga tegishli
    bo\u2018limni tanlang"
  - "\u0418\u0441\u0441\u043B\u0435\u0434\u0443\u0439\u0442\u0435 \u041D\u043E\u0432\u044B\u0439
    \L\u0423\u0437\u0431\u0435\u043A\u0438\u0441\u0442\u0430\u043D \u2014 \u043A\u043E\u0441\u043D\u0438\u0442\u0435\u0441\u044C
    \L\u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0443\u044E\u0449\u0435\u0439 \u0437\u043E\u043D\u044B"

    \u044D\u0442\u043E\_\u0432\u044B\u0431\u043E\u0440 \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043E,
    \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u043D\u044B\u0439\L\u043D\u0430\_\u0446\u0435\u043D\u043D\u043E\u0441\u0442\u044F\u0445
    \u0441\u0432\u043E\u0431\u043E\u0434\u044B, \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E\u0441\u0442\u0438
    \u0438\_\u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u043E\u0433\u043E
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F. \u0417\u043E\u043D\u0430 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
    \u043E\_\u0444\u0438\u043B\u043E\u0441\u043E\u0444\u0438\u0438 \u0438\_\u0446\u0435\u043B\u044F\u0445
    \u043A\u043E\u043D\u0446\u0435\u043F\u0446\u0438\u0438 \xAB\u041D\u043E\u0432\u044B\u0439
    \u0423\u0437\u0431\u0435\u043A\u0438\u0441\u0442\u0430\u043D\xBB \u043A\u0430\u043A\_\u0438\u0434\u0435\u0439\u043D\u043E\u0433\u043E
    \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\_\u0440\u0435\u0444\u043E\u0440\u043C"

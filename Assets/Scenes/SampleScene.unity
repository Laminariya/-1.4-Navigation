  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0417\u043E\u043D\u0430 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
    \u0440\u0435\u0444\u043E\u0440\u043C\u044B \u0432 \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0439
    \u0441\u0444\u0435\u0440\u0435 \u0447\u0435\u0440\u0435\u0437 \u043F\u0440\u0438\u0437\u043C\u0443
    \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u043C\u0430\u0445\u0430\u043B\u043B\u0438.
    \u0421\u0435\u043C\u0435\u0440\u043A\u0430 \u043C\u0430\u0445\u0430\u043B\u043B\u0438
    \u2014 \u044D\u0442\u043E \u0441\u0435\u043C\u044C \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0445
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0439 \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0439
    \u0440\u0430\u0431\u043E\u0442\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u044F\u044E\u0442 \u0432 \u0441\u0435\u0431\u0435
    \u0432\u0441\u0435\u0445 \u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0445 \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u043E\u0432
    \u0436\u0438\u0437\u043D\u0438 \u043E\u0431\u0449\u0438\u043D\u044B. \u0417\u043E\u043D\u0430
    \u043E\u0441\u0432\u0435\u0449\u0430\u0435\u0442 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F
    \u0432 \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0438, \u0437\u0434\u0440\u0430\u0432\u043E\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0438
    \u0438 \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0439 \u0437\u0430\u0449\u0438\u0442\u0435
    \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u0438\u044F"

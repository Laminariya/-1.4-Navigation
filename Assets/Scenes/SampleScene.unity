  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Mazkur  hudud ijtimoiy sohadagi islohotlarni mahalla tizimi nuqtai nazaridan
    ko\u2018rsatib beradi. \"Mahalla yettiligi\" \u2013 bu jamoa hayotining barcha
    faol ishtirokchilarini o\u2018z ichiga olgan ijtimoiy faoliyatning ning yettita
    asosiy yo\u2018nalishidir. Har bir vakil o\u2018z sohasiga mas\u2019uldir. Ular
    birgalikda har bir mahalla miqyosida ijtimoiy himoya va rivojlanishning mukammal
    tizimini yaratadi. Hududda ta\u2019lim, sog\u2018liqni saqlash va aholini ijtimoiy
    himoya qilish sohalaridagi o\u2018zgarishlarni yoritilgan."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c049d47516a189445be42dc2f4d1d9ce, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
